<?xml version="1.0" encoding="utf-8"?>
<!-- Runs every test whose TestDuration is Short or shorter. See DiGi.Core.xUnit/Enums/TestDuration.cs. -->
<RunSettings>
  <RunConfiguration>
    <EnvironmentVariables>
      <DIGI_TEST_MAX_DURATION>Short</DIGI_TEST_MAX_DURATION>
    </EnvironmentVariables>
  </RunConfiguration>
</RunSettings>
